# Biến cho scripts/jira/*. Chuyển từ antigravity-testing-kit-main/scripts/integrations/jira/.env.example.
#
# CHÉP file này ra NGOÀI repo và ngoài workspace của AI, ví dụ:
#   ~/.aiqe/secrets/.env.jira
# rồi NGƯỜI chạy:  node --env-file=$HOME/.aiqe/secrets/.env.jira scripts/jira/jira_fetcher.js --issue KAN-1
# AI không đọc file này và không giữ token (docs/threat_model.md, hàng 🛡️). Script không tự tìm file .env.
# Không commit file đã điền.

# ---- Jira ----
# URL gốc, không có dấu / ở cuối. Cloud: https://<tên>.atlassian.net
JIRA_BASE_URL=https://your-domain.atlassian.net
# 3 = Jira Cloud (mặc định), 2 = Jira Server / Data Center
JIRA_API_VERSION=3
# Cloud: email + API token (https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_EMAIL=qa.user01@example.com
JIRA_API_TOKEN=
# Server/Data Center: Personal Access Token. Có PAT thì không cần EMAIL + API_TOKEN
JIRA_PAT=
# Field chứa Acceptance Criteria của dự án (ví dụ customfield_10050). Hỏi admin Jira.
# Để trống → script ghi "Not specified", không đoán field.
JIRA_AC_FIELD=

# ---- Xray ----
# cloud | server
XRAY_PLATFORM=cloud
# Xray Cloud: Settings → API Keys
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
