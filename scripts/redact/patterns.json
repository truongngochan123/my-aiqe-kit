{
  "_note": "Danh sách mẫu che dữ liệu nhạy cảm. Thứ tự có ý nghĩa: mẫu cụ thể đứng trước mẫu chung. 'allow': giá trị khớp mẫu này thì GIỮ NGUYÊN. Regex không bắt được hết: người phải kiểm tra lại.",
  "patterns": [
    {
      "id": "jwt",
      "description": "JSON Web Token",
      "regex": "eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}",
      "flags": "g",
      "replace": "[REDACTED-JWT]"
    },
    {
      "id": "auth-header",
      "description": "Header Authorization",
      "regex": "(Authorization\"?\\s*[:=]\\s*\"?)(?:Bearer|Basic|Token)?\\s*[A-Za-z0-9._~+/=-]{6,}",
      "flags": "gi",
      "replace": "$1[REDACTED-AUTH]"
    },
    {
      "id": "cookie-header",
      "description": "Header Cookie / Set-Cookie",
      "regex": "((?:Set-)?Cookie\"?\\s*[:=]\\s*\"?)[^\"\\r\\n]+",
      "flags": "gi",
      "replace": "$1[REDACTED-COOKIE]"
    },
    {
      "id": "known-token-prefix",
      "description": "Token có tiền tố đã biết (GitHub, OpenAI, Anthropic, Atlassian, AWS, Slack)",
      "regex": "\\b(?:gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-(?:ant-)?[A-Za-z0-9_-]{20,}|ATATT[A-Za-z0-9_=-]{20,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,})\\b",
      "flags": "g",
      "replace": "[REDACTED-TOKEN]"
    },
    {
      "id": "secret-key-value",
      "description": "Cặp khóa = giá trị có tên nhạy cảm (password, token, secret, api_key…), kể cả trong JSON",
      "regex": "((?:password|passwd|pwd|secret|client[_-]?secret|api[_-]?key|access[_-]?token|refresh[_-]?token|auth[_-]?token|token|session[_-]?id|otp)\"?\\s*[:=]\\s*\"?)([^\"'\\s,;&}]+)",
      "flags": "gi",
      "replace": "$1[REDACTED]"
    },
    {
      "id": "email",
      "description": "Địa chỉ email (giữ nguyên email dùng domain dành cho test theo RFC 2606)",
      "regex": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
      "flags": "g",
      "replace": "[REDACTED-EMAIL]",
      "allow": "@(?:example\\.(?:com|org|net)|[A-Za-z0-9.-]+\\.(?:test|invalid|example))$"
    },
    {
      "id": "phone-vn",
      "description": "Số điện thoại di động Việt Nam (+84 hoặc 0, đầu 3/5/7/8/9, 10 số)",
      "regex": "(?<!\\d)(?:\\+84|0)[35789]\\d{8}(?!\\d)",
      "flags": "g",
      "replace": "[REDACTED-PHONE]"
    },
    {
      "id": "cccd-vn",
      "description": "Số CCCD 12 chữ số (bắt đầu bằng 0)",
      "regex": "(?<!\\d)0\\d{11}(?!\\d)",
      "flags": "g",
      "replace": "[REDACTED-ID]"
    },
    {
      "id": "ipv4",
      "description": "Địa chỉ IPv4 (giữ nguyên 127.0.0.1 và 0.0.0.0)",
      "regex": "(?<![\\d.])(?:\\d{1,3}\\.){3}\\d{1,3}(?![\\d.])",
      "flags": "g",
      "replace": "[REDACTED-IP]",
      "allow": "^(?:127\\.0\\.0\\.1|0\\.0\\.0\\.0)$"
    }
  ]
}
