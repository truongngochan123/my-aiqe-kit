# Chép thành .env.sandbox (KHÔNG commit, đã có trong .gitignore).
# Chỉ chứa thông tin của MÔI TRƯỜNG SANDBOX và TÀI KHOẢN TEST QUYỀN THẤP.
# Token tích hợp (Jira, Xray, CI) KHÔNG đặt ở đây (rules/agent_safety.md mục 3).

# URL env được phép test, phải nằm trong sandbox_urls của .aiqe/project.aiqe.yml
BASE_URL=https://qa-sandbox.example.com

# Host được phép gọi ngoài BASE_URL (CDN, font…), cách nhau bằng dấu phẩy. Để trống = chỉ host của BASE_URL.
ALLOWED_HOSTS=

# Tài khoản test quyền thấp
TEST_USER=
TEST_PASSWORD=

# Prefix data của lần chạy (rules/id_conventions.md), ví dụ QA-r001
RUN_PREFIX=QA-r001
